# Auto detect text files and perform LF normalization
* text=auto

# Source & build files
*.c text eol=lf
*.h text eol=lf
*.cpp text eol=lf
*.hpp text eol=lf
*.py text eol=lf
CMakeLists.txt text eol=lf
*.cmake text eol=lf
sdkconfig.defaults text eol=lf

# Binary files
*.bin binary
*.elf binary
*.png binary
*.pdf binary
